extern(C) void* dpp_rt_allocate(long size, long alignment);
extern(C) void dpp_rt_deallocate(void* address);
extern(C) long dpp_rt_live_allocation_count();

void processRecord() {
    void* record = dpp_rt_allocate(128, 16);
    if (record == null) {
        return;
    }
    scope(exit) dpp_rt_deallocate(record);
}

int main() {
    long initialAllocations = dpp_rt_live_allocation_count();
    processRecord();
    if (dpp_rt_live_allocation_count() != initialAllocations) {
        return 1;
    }
    return 0;
}
