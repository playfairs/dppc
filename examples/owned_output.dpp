module owned_output;

extern(C) void* fopen(const(char)* path, const(char)* mode);
extern(C) int fputs(const(char)* text, void* stream);
extern(C) int fclose(void* stream);

struct OwnedOutput {
    void* stream;

    OwnedOutput(void* stream) {
        this.stream = stream;
    }

    ~this() {
        if (this.stream != null) {
            fclose(this.stream);
        }
    }
}

int main() {
    OwnedOutput output = OwnedOutput(fopen("build/dpp-report.txt", "w"));
    if (output.stream == null) {
        return 1;
    }

    int writeStatus = fputs("D++ report written through C stdio.", output.stream);
    if (writeStatus < 0) {
        return 1;
    }
    return 0;
}
